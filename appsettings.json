{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MovieRating": "Debug"
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017/?replicaSet=rs0",
    "DatabaseName": "MovieRatingDb"
  },
  "Jwt": {
    "Issuer": "MovieRating.Api",
    "Audience": "MovieRating.Api.Client",
    "AccessTokenExpirationMinutes": 30
  },
  "DeferredReviewAggregation": {
    "BatchSize": 10,
    "PollIntervalSeconds": 5,
    "LeaseDurationSeconds": 120
  },
  "MoviePurge": {
    "BatchSize": 100,
    "PollIntervalSeconds": 5,
    "LeaseDurationSeconds": 120
  },  
  "AllowedHosts": "*"
}